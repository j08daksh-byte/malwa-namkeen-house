# ─────────────────────────────────────────────────────────────────────────────
# MishtiChaat — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# NEVER prefix server-only secrets with VITE_ — that exposes them to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Supabase project URL (Dashboard → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — SERVER ONLY, never expose to browser or Vite
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email — Resend (https://resend.com) ───────────────────────────────────────

# Resend API key (Dashboard → API Keys). Leave blank to skip emails (enquiries still save).
RESEND_API_KEY=re_your_key_here

# From address — must be a verified domain in Resend
RESEND_FROM_EMAIL=no-reply@mishtichaat.com

# Admin notification email — where new enquiry alerts are sent
ADMIN_NOTIFICATION_EMAIL=contact@mishtichaat.com

# ── Application URL ───────────────────────────────────────────────────────────

# Production URL of the website (no trailing slash)
APP_URL=https://www.mishtichaat.com

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://www.mishtichaat.com,https://mishtichaat.com

# ── AI Chatbot — Google Gemini ────────────────────────────────────────────────

# Gemini API key (Google AI Studio → Get API Key)
GEMINI_API_KEY=your-gemini-api-key

# ── Business Config Overrides ─────────────────────────────────────────────────

# Google Maps link — provide when client sends the final Maps URL
GOOGLE_MAPS_URL=https://maps.google.com/?q=MishtiChaat+Bengaluru

# WhatsApp number (international format, no +). Default set in server/config.ts.
BUSINESS_WHATSAPP_NUMBER=919035056691

# ── WhatsApp Business API (optional — Phase 2) ────────────────────────────────
# Leave blank to use click-to-chat links only (current Phase 1 behaviour).
# Set when Meta WhatsApp Cloud API credentials are obtained.

WHATSAPP_PROVIDER=click_to_chat
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Supabase Anon Key — Required for Admin Dashboard ─────────────────────────
# Used by the frontend admin login page to call Supabase Auth.
# Safe to expose — this is the public anon key, NOT the service role key.
# Dashboard → Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=your-anon-key

# Exposed to Vite/browser for admin login (safe — anon key only, never service role)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── MongoDB & Authentication ──────────────────────────────────────────────────
# Connection string from MongoDB Atlas (Database → Connect → Drivers).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret key for signing user auth tokens (SERVER ONLY, minimum 32 random characters)
JWT_SECRET=your-jwt-secret-key-change-in-production

# ── Cloudinary Media Storage ──────────────────────────────────────────────────
# Credentials from Cloudinary Console (Dashboard → Product Environment Credentials).
# SERVER ONLY — never prefix with VITE_.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
