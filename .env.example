# ─────────────────────────────────────────────────────────────────────────────
# Malwa Namkeen House — Environment Configuration Example
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# NEVER prefix server-only secrets with VITE_ — that exposes them to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB & Authentication (Authoritative Database & Session Storage) ──────
# Connection string from MongoDB Atlas (Database → Connect → Drivers).
MONGODB_URI=mongodb+srv://<username>:<password>@malwa-namkeen.cqmvmyv.mongodb.net/?appName=malwa-namkeen
MONGODB_DB_NAME=malwa_namkeen

# ── Isolated Test Database Configuration (REQUIRED for Live E2E Testing) ──────
# Used ONLY when running live end-to-end test suites (NODE_ENV=test or IS_E2E_TEST=true).
# Must point to an isolated test database (e.g. malwa_namkeen_test) with a dedicated test user.
# The database name embedded in the URI path MUST match MONGODB_TEST_DB_NAME.
# Falling back to MONGODB_URI is strictly prohibited to guarantee zero production mutation.
MONGODB_TEST_URI=mongodb+srv://<test_username>:<test_password>@malwa-namkeen.cqmvmyv.mongodb.net/malwa_namkeen_test?retryWrites=true
MONGODB_TEST_DB_NAME=malwa_namkeen_test

# Dedicated Isolated Test Admin Credentials (REQUIRED for Live Full-System E2E Testing)
# Must be configured in .env.local for running tests/full_system_e2e.test.ts.
# Falling back to production ADMIN_EMAIL, ADMIN_PASSWORD, or hardcoded passwords is prohibited.
TEST_ADMIN_EMAIL=test_admin_e2e@malwa-isolated.test
TEST_ADMIN_PASSWORD=change_this_test_admin_password_123!

# JWT secret key for signing user & admin auth tokens (SERVER ONLY, minimum 32 random characters)
JWT_SECRET=your-jwt-secret-key-change-in-production

# Store Owner Super Administrator Email(s) (Automatically designated as super_admin)
# Can be a single email or comma-separated list, or use ADMIN_EMAILS
ADMIN_EMAIL=admin@malwanamkeen.com
ADMIN_EMAILS=admin@malwanamkeen.com,owner@malwanamkeen.com

# Initial Super Admin Bootstrap Password (used only when auto-seeding the initial owner in a blank DB)
# Must be at least 8 characters. Change immediately after initial login.
ADMIN_PASSWORD=change_this_secure_owner_password_123!

# ── Cloudinary Media Storage ──────────────────────────────────────────────────
# Credentials from Cloudinary Console (Dashboard → Product Environment Credentials).
# SERVER ONLY — never prefix with VITE_.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Email — Transactional Email via Resend (https://resend.com) ─────────────
# Email delivery provider: 'resend' (production delivery) or 'simulated' (local development & testing).
# In production, defaults to 'resend' if RESEND_API_KEY is present, or drops safely ('unconfigured') if missing.
# During test execution or when EMAIL_PROVIDER=simulated, emails are safely logged to console without network calls.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Malwa Namkeen House <orders@malwanamkeen.com>
# Store administrative mailbox for incoming order notifications, customer enquiries, and system alerts:
ADMIN_NOTIFICATION_EMAIL=malwanamkeenhouse@gmail.com

# ── AI Culinary Concierge — Google Gemini ─────────────────────────────────────
# Gemini API key (Google AI Studio → Get API Key)
GEMINI_API_KEY=your-gemini-api-key

# ── Application URL & WhatsApp ────────────────────────────────────────────────
APP_URL=https://malwanamkeen.com
ALLOWED_ORIGINS=https://malwanamkeen.com,http://localhost:3000
BUSINESS_WHATSAPP_NUMBER=917987732765